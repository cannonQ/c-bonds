# c-bonds environment. Copy to .env (gitignored) — never commit .env.
# The harness signs locally and uses only public node endpoints, so no
# node API key or node-wallet mnemonic is required.

NODE_URL=http://127.0.0.1:9053
# Optional; only needed if a future tool touches authenticated endpoints.
NODE_API_KEY=
# Optional; defaults to the public Ergo explorer API.
EXPLORER_URL=

# Test wallets — DUST ONLY, generated by: sbt "runMain bonds.GenWallets"
# GenWallets refuses to run unless .env is confirmed gitignored.
BORROWER_MNEMONIC=
LENDER_MNEMONIC=
KEEPER_MNEMONIC=

# Expected EIP-3 index-0 P2PK addresses — harness aborts if derived address differs
BORROWER_EXPECTED_ADDRESS=
LENDER_EXPECTED_ADDRESS=
KEEPER_EXPECTED_ADDRESS=
